# .env.example - Plantilla para nuevas instalaciones
# COPIA ESTE ARCHIVO A .env Y COMPLETA TUS DATOS

# ============================================================
# CONFIGURACIÓN DE RUTAS (CAMBIA EN CADA PC)
# ============================================================

# 📂 Ruta donde está el proyecto
PROJECT_ROOT=C:/Users/TU_USUARIO/Desktop/jarvis-system

# 📂 Ruta del Vault de Obsidian
VAULT_PATH=C:/Users/TU_USUARIO/Desktop/MiCerebroDigital

# ============================================================
# FOOOCUS (Generación de imágenes)
# ============================================================
FOOOCUS_URL=http://127.0.0.1:7865
FOOOCUS_MODELS=C:/Ruta/Fooocus_Models
FOOOCUS_OUTPUT=C:/Ruta/Fooocus_Outputs/images

# ============================================================
# INVOKEAI (Generación de imágenes alternativa)
# ============================================================
INVOKEAI_URL=http://127.0.0.1:9090/api
INVOKEAI_MODEL=sdxl-1.0

# ============================================================
# N8N (Automatizaciones)
# ============================================================
N8N_WEBHOOK_URL=http://localhost:5678/webhook-test/jarvis-action

# ============================================================
# API KEYS (¡COPIA TUS CLAVES AQUÍ!)
# ============================================================
GROQ_API_KEY=gsk_TU_CLAVE_AQUI
GEMINI_API_KEY=AQ.TU_CLAVE_AQUI
OPENROUTER_API_KEY=sk-or-v1-TU_CLAVE_AQUI
META_ACCESS_TOKEN=EAAOTU_TOKEN_AQUI
INSTAGRAM_ACCESS_TOKEN=EAAOTU_TOKEN_AQUI

# ============================================================
# INSTAGRAM BUSINESS
# ============================================================
INSTAGRAM_BUSINESS_ID=17841415579405374
INSTAGRAM_VERIFY_TOKEN=Jarvisgideon
DISABLE_COMMENT_RESPONSES=true

# ============================================================
# URL PÚBLICA (ngrok)
# ============================================================
PUBLIC_URL=https://tu-ngrok-url.ngrok-free.dev

# ============================================================
# INSTAGRAM - CUENTA SECUNDARIA (Alhorno Directo)
# ============================================================
INSTAGRAM_ACCESS_TOKEN_ALHORNO=EAAY...
INSTAGRAM_BUSINESS_ID_ALHORNO=17841442269419568
FACEBOOK_PAGE_ID_ALHORNO=1260265530508456